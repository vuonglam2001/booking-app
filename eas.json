{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "cache": {
        "key": "preview-v1"
      },
      "env": {
        "NO_FLIPPER": "1"
      }
    },
    "production": {}
  },
  "submit": {
    "production": {}
  }
}
